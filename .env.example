# ───────────────────────── ReviseX backend ─────────────────────────
# Copy to .env and edit. Every value below has a safe default; the app runs
# with NO .env file at all.

APP_NAME=ReviseX
APP_ENV=development
API_PREFIX=/api

HOST=0.0.0.0
PORT=8000
# Comma-separated. Add your Vite preview origin here if it differs.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ───────────────────────── Database ─────────────────────────
# THE most important setting for a public deploy.
#
# Set it to a Postgres connection string (Neon, Supabase, RDS...) and all
# accounts, progress, streaks and friendships live there:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST-REGION.aws.neon.tech/DBNAME?sslmode=require
# Copy it from Neon's dashboard -> your project -> Connection Details, and use
# the POOLED connection string if offered. The free Render plan gives few
# concurrent connections and a cold start opens several at once.
#
# Leave it unset and the app uses a local SQLite file instead. That is right
# for development and right for a single-user offline install; it is NOT right
# for a public deploy, because on Render's free tier the file is ephemeral and
# every restart discards all student progress.
#
# Never commit a real connection string. It contains the database password.
# DATABASE_URL=

# ───────────────────────── Local data ─────────────────────────
# SQLite file lives here. Safe to delete: it is rebuilt and reseeded on start.
# DATA_DIR=./backend/data
# DB_FILENAME=revise.sqlite3
# CONTENT_DIR=./backend/content

# ───────────────────────── Google sign-in (optional) ─────────────────────────
# Leave all three unset and the app runs on username+password only; the
# "Continue with Google" button hides itself rather than failing when clicked.
#
# Get these from Google Cloud Console -> APIs & Services -> Credentials ->
# Create Credentials -> OAuth client ID -> Web application.
#
# Under "Authorized redirect URIs" add EXACTLY:
#   https://YOUR-APP.onrender.com/api/auth/google/callback
# Google rejects the flow on any mismatch, including a trailing slash.
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET is a secret. Server-side only; never sent to the browser.
# GOOGLE_CLIENT_SECRET=

# Your public URL, no trailing slash. Derives the redirect URI above.
# PUBLIC_BASE_URL=https://revisex-2i5g.onrender.com
# Or state the redirect URI outright, which wins if both are set:
# GOOGLE_REDIRECT_URI=

# ───────────────────────── Admin ─────────────────────────
# Comma-separated usernames granted the admin panel: live usage, per-student
# stats, and audited access into a student's account.
#
# Checked when an account signs up AND on every boot, so the first admin needs
# no existing admin to promote them. Setting this does not create an account -
# it promotes one that matches by username.
#
# Impersonation is logged to admin_audit permanently. Only list usernames you
# trust with every student's data.
# ADMIN_USERNAMES=

# ───────────────────────── Content policy ─────────────────────────
# Include off-syllabus chapters (Periodic Classification, Sources of Energy) in
# default test selection. Leave false for board-exam preparation.
ALLOW_OFF_SYLLABUS=false

# NEVER enable in production. AI items are quarantined as `pending_review`
# and must be approved in the content studio before students see them.
AUTO_APPROVE_AI_ITEMS=false

# ───────────────────────── AI (all optional) ─────────────────────────
# local | ollama | free_api | paid_api | none
# "local" = deterministic offline generator. Always works, zero cost.
AI_PROVIDER=local

# Only used when AI_PROVIDER=ollama. Install from https://ollama.com and run:
#   ollama pull llama3.2:3b
# If Ollama is unreachable the app silently falls back to the local provider.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_S=20

# Only used when AI_PROVIDER=free_api. Keys are read SERVER-SIDE ONLY and are
# never sent to the browser.
# FREE_AI_API_URL=
# FREE_AI_API_KEY=
# PAID_AI_API_KEY=

CLIENT_VERSION=0.1.0

# ───────────────────────── Frontend ─────────────────────────
# Vite proxies /api to this URL, so browser code never hard-codes a host.
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- Frontend (build-time; only needed for a SPLIT deploy) -------------
# Absolute API origin INCLUDING the /api prefix, e.g.
#   VITE_API_URL=https://revisex.onrender.com/api
# Leave unset for local dev (Vite proxies /api) and for single-origin deploys
# where FastAPI serves frontend/dist. Inlined at build time: changing it
# requires a rebuild, not a restart.
# VITE_API_URL=
